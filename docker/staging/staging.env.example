# ==============================================================================
# Creativanta Video Engine - Isolated Staging Environment Template (Task P10-A)
#
# IMPORTANT:
# - Staging-only non-production template; NOT a production config.
# - Contains NO default secrets or fallback credentials.
# - Every required value MUST be explicitly supplied before startup; the API
#   bootstrap layer (packages/api/src/db/backend-bootstrap.ts) rejects missing
#   values, dev placeholders (cve_dev_*, minioadmin, dev_pepper_*, all-zero
#   image digests), and non-cve_api runtime database roles.
# ==============================================================================

CVE_ENV=staging
CVE_BACKEND_MODE=postgres
CVE_PUBLIC_BASE_URL=https://staging-video.creativanta.internal/v1
CVE_LOG_LEVEL=info
CVE_COST_RATE_VERSION=v1

# Runtime DB role MUST be least-privilege 'cve_api' (NOBYPASSRLS).
# Never pass 'cve_migrator' or 'postgres' to CVE_DATABASE_URL.
CVE_DATABASE_URL=
CVE_MIGRATION_DATABASE_URL=

# S3-compatible private staging object store (HTTPS required; 3 distinct non-dev buckets)
CVE_STORAGE_ENDPOINT=https://staging-s3.creativanta.internal
CVE_STORAGE_REGION=ap-southeast-1
CVE_STORAGE_ACCESS_KEY_ID=
CVE_STORAGE_SECRET_ACCESS_KEY=
CVE_QUARANTINE_BUCKET=cve-quarantine-staging
CVE_ASSET_BUCKET=cve-assets-staging
CVE_ARTIFACT_BUCKET=cve-artifacts-staging
CVE_SIGNED_DOWNLOAD_TTL_SECONDS=300
CVE_ARTIFACT_RETENTION_DAYS=7
CVE_ASSET_RETENTION_DAYS=7

# Cryptographic secrets (>= 32 bytes random pepper; non-dev KMS key ref)
CVE_API_KEY_PEPPER=
CVE_SECRET_ENCRYPTION_KEY_ID=
CVE_EGRESS_POLICY_PATH=/etc/cve/egress-policy.json

# Renderer adapter & pinned non-zero OCI image digest
CVE_RENDERER_ADAPTER=chromium-frame-v1
CVE_RENDER_IMAGE_DIGEST=
CVE_WORKER_READINESS_URL=http://127.0.0.1:8081/readyz
CVE_RENDER_SLOTS=1
CVE_RENDER_CPU_LIMIT=2
CVE_RENDER_MEMORY_MIB=4096
CVE_RENDER_PIDS_LIMIT=256
CVE_RENDER_TEMP_MIB=8192
CVE_FRAME_TIMEOUT_MS=5000
CVE_RENDER_TIMEOUT_SECONDS=600
CVE_PREVIEW_TIMEOUT_SECONDS=120
CVE_JOB_DEADLINE_SECONDS=1800
CVE_LEASE_SECONDS=60
CVE_HEARTBEAT_SECONDS=15
CVE_MAX_ATTEMPTS=3

# Mandatory fail-closed safety gates (Issue #61 / docs/SECURITY.md)
CVE_REMOTE_IMPORT_ENABLED=false
CVE_CUSTOM_CODE_ENABLED=false
CVE_CUSTOM_RUNTIME=disabled
CVE_CUSTOM_TENANT_ALLOWLIST=
CVE_AUTHORING_PROVIDER=disabled
CVE_AUTHORING_SECRET_REF=
CVE_TTS_PROVIDER=disabled
CVE_TTS_SECRET_REF=
