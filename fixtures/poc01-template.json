{
  "id": "tpl_poc01_promo",
  "revision": 1,
  "name": "Product Promo Vertical 15s Template",
  "description": "Template quảng cáo sản phẩm 15 giây dọc (9:16, 720x1280) gồm 3 phân cảnh có thể tùy biến tiêu đề, giá tiền và nút kêu gọi hành động.",
  "variables_schema": {
    "type": "object",
    "required": ["badge_text", "headline", "price", "cta_text"],
    "additionalProperties": false,
    "properties": {
      "badge_text": {
        "type": "string",
        "maxLength": 30,
        "description": "Nhãn huy hiệu ưu đãi trên đầu khung hình"
      },
      "headline": {
        "type": "string",
        "maxLength": 60,
        "description": "Tiêu đề chính giới thiệu sản phẩm"
      },
      "price": {
        "type": "string",
        "maxLength": 20,
        "description": "Mức giá hiển thị kèm ký hiệu tiền tệ ₫"
      },
      "cta_text": {
        "type": "string",
        "maxLength": 40,
        "description": "Văn bản trên nút kêu gọi hành động (CTA)"
      },
      "product_asset_id": {
        "type": "string",
        "default": "ast_product_autumn",
        "description": "Mã định danh tài nguyên hình ảnh sản phẩm"
      }
    }
  },
  "defaults": {
    "badge_text": "SIÊU ƯU ĐÃI",
    "headline": "Bộ sưu tập Mùa Thu 2026",
    "price": "Chỉ từ 199.000 ₫",
    "cta_text": "Mua ngay hôm nay",
    "product_asset_id": "ast_product_autumn"
  },
  "supported_locales": ["vi-VN", "en-US"],
  "required_capabilities": ["engine:html-v1", "profile:mp4-720p-v1"],
