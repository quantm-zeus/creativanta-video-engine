  "findings": [
    {
      "id": "SEC-P6-001",
      "severity": "HIGH",
      "category": "secrets_and_log_redaction",
      "title": "Ops RedactedLogger regex missed 77-char API key suffixes and whsec_/URI credentials",
      "affectedFiles": [
        "ops/logging/redacted-logger.mjs",
        "ops/test/redacted-logger.test.mjs"
      ],
      "rootCause": "API_KEY_PREFIX_REGEX in ops/logging/redacted-logger.mjs bounded the suffix after cve_live_ to {16,64} characters with a trailing word boundary (\\b). Real API keys issued by generateApiKeyMaterial() have a 77-character suffix (<12hex>_<64hex>), causing full API keys in free-form log strings to bypass regex redaction. Additionally, whsec_ webhook secrets, PEM private keys, and connection URI passwords lacked dedicated string patterns.",
      "remediation": "Expanded API_KEY_PREFIX_REGEX to {12,128}, added WEBHOOK_SECRET_REGEX (whsec_), EXTERNAL_SECRET_REGEX (sk-, ghp_, AKIA), PRIVATE_KEY_BLOCK_REGEX, CONNECTION_URI_CREDENTIALS_REGEX, and expanded sensitive object key suffix matching in redactObject().",
      "status": "RESOLVED",
      "verifiedByChecks": [
        "RND-SEC-08",
        "API-SEC-01",
        "API-SEC-07"
      ]
    },
    {
      "id": "SEC-P6-002",
      "severity": "LOW",
      "category": "multi_tenant_isolation_runbook",
      "title": "Runbook 6 synthetic verification used static statusCode = 404 instead of live TenantRepository probe",
      "affectedFiles": [
        "ops/runbooks/synthetic-runbook-runner.mjs"
      ],
      "rootCause": "SyntheticRunbookRunner.runRunbook6TenantIsolation() simulated the 404 anti-IDOR outcome with a static variable rather than invoking TenantRepository with an authenticated cross-tenant context.",
      "remediation": "Updated runRunbook6TenantIsolation() to initialize an in-memory SQLite database with MigrationRunner, TenantConnectionPool, and TenantRepository, create a victim asset, execute a cross-tenant getAsset() probe, verify ResourceNotFoundError (404 NOT_FOUND), and persist attacker tenant suspension.",
      "status": "RESOLVED",
      "verifiedByChecks": [
        "API-SEC-02"
      ]
    }
  ],
