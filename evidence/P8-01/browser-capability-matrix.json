  "security_boundaries": {
    "zero_egress_and_scoped_grants": "Browser export must only fetch assets via short-lived signed URLs (TTL <= 10 min) or local user files (File / Blob / OPFS). No persistent tenant API keys or secret credentials stored in browser localStorage or IndexedDB.",
    "memory_dos_and_jetsam_protection": "Browser memory is strictly bounded: 4096 MiB on desktop, 1024 MiB on iOS, 2048 MiB on Android. Resolutions exceeding platform ceiling (such as 4K or 1080p on iOS) are automatically rejected locally and redirected to server jobs.",
    "no_arbitrary_code_execution": "Browser export only parses and executes deterministic Scene Spec 1.0 JSON AST. No dynamic script evaluation (eval, new Function, remote scripts) is permitted.",
    "background_tab_handling": "Browser export render loop must execute inside a DedicatedWorker utilizing OffscreenCanvas. If running on mobile where background execution is killed by the OS, the UI must acquire a Screen WakeLock."
