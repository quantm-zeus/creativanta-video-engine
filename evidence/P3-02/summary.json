      "svg_max_nodes": 5000,
      "svg_max_depth": 16,
      "font_required_tables": ["cmap", "head", "hhea", "hmtx", "maxp"],
      "image_max_dimension_px": 8192,
      "image_max_pixels": 40000000,
      "sandbox_probe_timeout_ms": 5000,
      "sandbox_probe_max_buffer_bytes": 1048576
    },
    "foreign_asset_isolation": {
      "path_behavior": "404 NOT_FOUND",
      "no_tenant_leakage": true
    }
  },
