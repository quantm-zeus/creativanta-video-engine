{
  "openapi": "3.1.0",
  "info": {
    "title": "Creativanta Video Engine - AI Authoring Extension API",
    "version": "1.0.0",
    "description": "Provider-Neutral AI Scene Authoring Adapter API (Tasks P7-03 & P7-06). Generates source-only custom scene bundles within strict token, time, and cost budgets with zero subscription required."
  },
  "servers": [
    {
      "url": "https://api.creativanta.internal/v1",
      "description": "Internal VaaS Production Gateway"
    },
    {
      "url": "http://127.0.0.1:4000/v1",
      "description": "Local Development / Isolated Test Server"
    }
  ],
  "security": [
    {
      "TenantApiKeyAuth": [
        "authoring:write",
        "authoring:read"
      ]
    }
  ],
  "paths": {
    "/authoring-jobs": {
      "post": {
        "summary": "Submit an AI scene bundle authoring job",
        "operationId": "createAuthoringJob",
        "tags": [
          "Authoring"
        ],
        "security": [
          {
            "TenantApiKeyAuth": [
              "authoring:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthoringJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Authoring job accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthoringJobSummary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid creative brief or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Missing authoring:write scope or tenant not allowlisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity - Reference to unapproved asset ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests or authoring rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List authoring jobs for the authenticated tenant",
        "operationId": "listAuthoringJobs",
        "tags": [
          "Authoring"
        ],
        "security": [
          {
            "TenantApiKeyAuth": [
              "authoring:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Filter by job state",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "authoring",
                "succeeded",
                "failed",
                "canceled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of authoring jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jobs",
                    "total",
                    "cursor",
                    "limit",
                    "has_more"
                  ],
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuthoringJobSummary"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "cursor": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/authoring-jobs/{id}": {
      "get": {
        "summary": "Get authoring job status and source output",
        "operationId": "getAuthoringJob",
        "tags": [
          "Authoring"
        ],
        "security": [
          {
            "TenantApiKeyAuth": [
              "authoring:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique authoring job ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoring job status and output details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthoringJobDetail"
                }
              }
            }
          },
          "404": {
            "description": "Job not found or belongs to another tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/authoring-jobs/{id}/cancel": {
      "post": {
        "summary": "Cancel an in-flight or queued authoring job",
        "operationId": "cancelAuthoringJob",
        "tags": [
          "Authoring"
        ],
        "security": [
          {
            "TenantApiKeyAuth": [
              "authoring:write"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "default": "Canceled by user request"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoring job successfully canceled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthoringJobSummary"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/authoring-providers": {
      "get": {
        "summary": "List available authoring adapters and model pricing",
        "operationId": "listAuthoringProviders",
        "tags": [
          "Authoring"
        ],
        "security": [
          {
            "TenantApiKeyAuth": [
              "authoring:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "List of provider-neutral adapters and supported routes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "providers"
                  ],
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuthoringProviderInfo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TenantApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Tenant API Key with authoring:write or authoring:read scopes"
      }
    },
    "schemas": {
      "AuthoringJobRequest": {
        "type": "object",
        "required": [
          "brief"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "description": "Creative animation brief or instruction prompt (Unicode NFC)",
            "maxLength": 10000
          },
          "locale": {
            "type": "string",
            "description": "Locale for typography and diacritics formatting",
            "default": "vi-VN"
          },
          "approved_asset_ids": {
            "type": "array",
            "description": "Explicit allowlist of tenant asset IDs available to the scene",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "provider_preference": {
            "type": "string",
            "description": "Preferred provider adapter ID",
            "default": "mock-deterministic"
          },
          "model": {
            "type": "string",
            "description": "Specific model identifier"
          },
          "budgets": {
            "$ref": "#/components/schemas/AuthoringBudgets"
          },
          "target": {
            "$ref": "#/components/schemas/AuthoringTarget"
          },
          "seed": {
            "type": "string",
            "description": "Seed for deterministic generation"
          },
          "options": {
            "type": "object",
            "description": "Additional provider-specific options"
          }
        }
      },
      "AuthoringBudgets": {
        "type": "object",
        "properties": {
          "max_tokens": {
            "type": "integer",
            "default": 16384,
            "maximum": 65536
          },
          "max_completion_tokens": {
            "type": "integer",
            "default": 8192,
            "maximum": 32768
          },
          "timeout_ms": {
            "type": "integer",
            "default": 60000,
            "maximum": 180000
          },
          "max_cost_usd": {
            "type": "number",
            "default": 0.5,
            "maximum": 10
          }
        }
      },
      "AuthoringTarget": {
        "type": "object",
        "properties": {
          "bundle_type": {
            "type": "string",
            "default": "custom-html-v1"
          },
          "width": {
            "type": "integer",
            "default": 1920
          },
          "height": {
            "type": "integer",
            "default": 1080
          },
          "fps": {
            "type": "integer",
            "default": 30
          },
          "duration_seconds": {
            "type": "number",
            "default": 5
          }
        }
      },
      "AuthoringJobSummary": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "state",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "authoring",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "cancellation_reason": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "AuthoringJobDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthoringJobSummary"
          },
          {
            "type": "object",
            "properties": {
              "request": {
                "$ref": "#/components/schemas/AuthoringJobRequest"
              },
              "output": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "entrypoint": {
                    "type": "string"
                  },
                  "source_sha256": {
                    "type": "string"
                  },
                  "build_sha256": {
                    "type": "string"
                  },
                  "csp_script_hash": {
                    "type": "string"
                  },
                  "declared_capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "parameter_schema": {
                    "type": "object"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "metering": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "prompt_tokens": {
                    "type": "integer"
                  },
                  "completion_tokens": {
                    "type": "integer"
                  },
                  "total_tokens": {
                    "type": "integer"
                  },
                  "duration_ms": {
                    "type": "integer"
                  },
                  "cost_usd": {
                    "type": "number"
                  },
                  "cost_micros": {
                    "type": "integer"
                  }
                }
              },
              "error": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "AuthoringProviderInfo": {
        "type": "object",
        "required": [
          "id",
          "name",
          "providerType",
          "isSubscriptionRequired"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "providerType": {
            "type": "string",
            "enum": [
              "mock",
              "local",
              "remote"
            ]
          },
          "isSubscriptionRequired": {
            "type": "boolean"
          },
          "defaultModel": {
            "type": "string"
          },
          "supportedModels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "contextTokens": {
                  "type": "integer"
                },
                "requiresSubscription": {
                  "type": "boolean"
                },
                "promptCostPer1k": {
                  "type": "number"
                },
                "completionCostPer1k": {
                  "type": "number"
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  }
}
